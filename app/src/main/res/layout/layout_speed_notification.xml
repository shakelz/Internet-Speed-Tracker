<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/bg_card">

    <!-- Top Speeds Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Download Speed -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_download_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="0.0 KB/s"
            android:textColor="@color/speed_download"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Upload Speed -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_up"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_upload_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="0.0 KB/s"
            android:textColor="@color/speed_upload"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/divider_color"
        android:contentDescription="@null" />

    <!-- Daily Usage Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Mobile Data -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sim"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_mobile_usage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Mobile: 0 MB"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Wi-Fi Data -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_wifi"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_wifi_usage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Wi-Fi: 0 MB"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Network Name / Status -->
    <TextView
        android:id="@+id/notif_network_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Connected: Wi-Fi"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

</LinearLayout>
